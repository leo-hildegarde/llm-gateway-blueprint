# Demo-only placeholders. Never commit a real .env file.

# Gateway. LiteLLM proxy keys use the sk- prefix.
LITELLM_MASTER_KEY=sk-replace-with-random-value

# Database
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=replace-with-random-value

# Runnable baseline provider
OPENAI_API_KEY=replace-me

# Public blueprint routing aliases
AUTO_TIER_LIGHT=fast
AUTO_TIER_MEDIUM=balanced
AUTO_TIER_HEAVY=reasoning
